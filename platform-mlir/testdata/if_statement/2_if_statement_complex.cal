actor IfComplex() int In ==> int Out:
    action In:[t] ==> Out:[t + x + y]
    var
        int x := 0,
        int y := 0
    do
        // 1. An if with no else statement
        if t >= 20 then
            x := x + 1;
        end

        // 2. If statement where assignments of different variables are made
        if t >= 40 then
            x := x + 1;
        else
            y := y + 1;
        end

        // 3. Nested If statements, note nestings >= 3 result in errors right now
        if t < 60 then
            x := x + 0;
            if t < 40 then
                x := x + 100000;
            end
        end

        // 4. If statement, no return
        if t < 80 then

        end
    end
end