// Expected Output
// Tx: 1
// t: 1.000000
// x1: 100.500000
// x2: 101.500000
// x3: 99.500000
// x4: 995.000000
// x5: 497.500000
// x6: -497.500000
// y1: 100
// y2: 101
// y3: 98
// y4: 1029
// y5: 411
// y6: -411
// Rx: -497.500000

namespace simple:
    actor BinaryExprFpAndIntMixed() float In ==> float Out:
        action In:[t] ==> Out:[x]
        var
            // Multiple binary expressions chained: 100
            float x,
            int y := 25 + 25.0 + 25 + 25.0 + 0.5
        do

            println("t: " + t);

            x := 25 + 25.0 + 25 + 25.0 + 0.5; // 100.500000
            println("x1: " + x);
            x := x + 1;  // 101.500000
            println("x2: " + x);
            x := x - 2;  // 99.500000
            println("x3: " + x);
            x := 10 * x; // 995.000000
            println("x4: " + x);
            x := x / 2;  // 497.500000
            println("x5: " + x);
            x := -x; // -497.500000
            println("x6: " + x);

            println("y1: " + y);
            y := y + 1.5;  // 101
            println("y2: " + y);
            y := y - 2.5;  // 98
            println("y3: " + y);
            y := y * 10.5; // 1029
            println("y4: " + y);
            y := y / 2.5;  // 411
            println("y5: " + y);
            y := -y; // -411
            println("y6: " + y);
        end
    end

    actor Source(int payload_size) ==> float Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter
        do
            t :=  t+1;
            println("Tx: " + t);
            counter := counter + 1;
        end
    end

    actor Sink() float In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source = Source(payload_size = 1);
            DUT  = BinaryExprFpAndIntMixed() {};
            sink = Sink();
    structure
            source.Out --> DUT.In { bufferSize = 1; };
            DUT.Out --> sink.In { bufferSize = 1; } ;
    end
end