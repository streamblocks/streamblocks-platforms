// Expected Output
// Tx: 2.100000
// 1: 100.000000
// 2: 101.099998
// 3: 98.900002
// 3: 998.890076
// 4: 434.300049
// 5: -434.300049
// Rx: -434.300049


namespace simple:
    actor BinaryExprFloat() float In ==> float Out:
        action In:[t] ==> Out:[x]
        var
            // Multiple binary expressions chained: 100
            float x := 25.0 + 25.0 + 25.0 + 25.0
        do
            println("1: " + x);
            x := x + 1.1;  // 101.099998
            println("2: " + x);
            x := x - 2.2;  // 98.900002
            println("3: " + x);
            x := x * 10.1; // 998.890076
            println("3: " + x);
            x := x / 2.3;  // 434.300049
            println("4: " + x);
            x := -x; // -434.300049
            println("5: " + x);
        end
    end

    actor Source(int payload_size) ==> float Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := 1.1
        do
            t :=  t+1.0;
            println("Tx: " + t);
            counter := counter + 1;
        end
    end

    actor Sink() float In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source = Source(payload_size = 1);
            DUT  = BinaryExprFloat() {};
            sink = Sink();
    structure
            source.Out --> DUT.In { bufferSize = 1; };
            DUT.Out --> sink.In { bufferSize = 1; } ;
    end
end