// Expected Output:
// Tx: 0
// a: 1
// b: 1
// a: 2
// b: 2
// a: 3
// b: 3
// a: 4
// b: 4
// Rx: 4
// Tx: 1
// a: 1
// b: 5
// a: 2
// b: 6
// a: 3
// b: 7
// a: 4
// b: 8
// Rx: 4

namespace simple:
  actor Source(int payload_size) ==> int Out:
    int counter := 0;
    transmit: action ==> Out:[t]
    guard counter < payload_size
    var t = counter
    do
      println("Tx: " + t);
      counter := counter + 1;
    end
  end

  actor Sink() int In ==>:
    action In:[t] ==>
    do
        println("Rx: " + t);
    end
  end

    actor StateAndForEach() int In ==> int Out:
        int b := 0;

        action In:[t] ==> Out:[a]
        var
            int a := 0
        do
            foreach uint j in 1..5 do
                a := a + 1;
                b := b + 1;
                println("a: " + a);
                println("b: " + b);
            end
        end
    end

  network Top() ==> :
  entities
    source = Source(payload_size = 2);
    DUT  = StateAndForEach();
    sink = Sink();
  structure
    source.Out --> DUT.In { bufferSize = 1; };
    DUT.Out --> sink.In { bufferSize = 1; } ;
  end

end