namespace simple:
    actor Merge() int In1, int In2, int In3 ==> int Out:
        action In1:[t] ==> Out:[t] end
        action In2:[t] ==> Out:[t] end
        action In3:[t] ==> Out:[t] end
    end

    actor Source(int payload_size, int actor_index) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 100*actor_index
        do
            println("Src: " + actor_index + " " + t);
            counter := counter + 1;
        end
    end

    actor Sink() int In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source1 = Source(payload_size = 4, actor_index = 1);
            source2 = Source(payload_size = 4, actor_index = 2);
            source3 = Source(payload_size = 4, actor_index = 3);
            merge  = Merge() {};
            sink = Sink();
    structure
            source1.Out --> merge.In1 { bufferSize = 1; };
            source2.Out --> merge.In2 { bufferSize = 1; };
            source3.Out --> merge.In3 { bufferSize = 1; };
            merge.Out --> sink.In { bufferSize = 1; } ;
    end
end