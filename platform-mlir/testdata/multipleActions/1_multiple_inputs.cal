namespace simple:
    actor Merge() int In1, int In2, int In3 ==> int Out:
        action In1:[t] ==> Out:[t] end
        action In2:[t] ==> Out:[t] end
        action In3:[t] ==> Out:[t] end

        // action In:[t1] ==> Out:[list] repeat 4
        // var
        // List(type:uint, size=4) list := [1,2,3,4],
        // uint index := 0
        // do
        //     list[0] := 1;
        //     while list[0] < 4 do
        //         list[list[0]] := t1 + list[0];
        //         list[0] := list[0] + 1;
        //     end
        //     //println("List: " + list[0] + ", " + list[1] + ", " + list[2] + ", " + list[3]);
        // end
    end

    actor Source1(int payload_size) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 1*10
        do
            println("Src1: " + t);
            counter := counter + 1;
        end
    end

    actor Source2(int payload_size) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 2*10
        do
            println("Src2: " + t);
            counter := counter + 1;
        end
    end

    actor Source3(int payload_size) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 3*10
        do
            println("Src3: " + t);
            counter := counter + 1;
        end
    end

    actor Sink() int In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source1 = Source1(payload_size = 4);
            source2 = Source2(payload_size = 4);
            source3 = Source3(payload_size = 4);
            merge  = Merge() {};
            sink = Sink();
    structure
            source1.Out --> merge.In1 { bufferSize = 1; };
            source2.Out --> merge.In2 { bufferSize = 1; };
            source3.Out --> merge.In3 { bufferSize = 1; };
            merge.Out --> sink.In { bufferSize = 1; } ;
    end
end