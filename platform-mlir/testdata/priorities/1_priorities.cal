// Expected Output:
// Tx0: 1
// Rx0: 1
// Tx0: 2
// Rx0: 2


namespace simple:
    actor PrioritisedActions() int In ==> int Out:
        act1: action In:[t] ==> Out:[t] end
        act2: action In:[t] ==> Out:[t] end
        act3: action In:[t] ==> Out:[t] end
        act4: action In:[t] ==> Out:[t] end

        priority
            act1 > act2;
            act1 > act3;
            act2 > act3;
        end
    end

    actor Source(int payload_size, int actor_index) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 100*actor_index
        do
            t :=  t+1;
            println("Tx" + actor_index + ": " + t);
            counter := counter + 1;
        end
    end

    actor Sink(int actor_index) int In ==>:
        action In:[t] ==>
        do
            println("Rx" + actor_index + ": " + t);
        end
    end

    network Top() ==> :
    entities
            source1 = Source(payload_size = 2, actor_index = 0);
            //source2 = Source(payload_size = 2, actor_index = 1);
            DUT  = PrioritisedActions() {};
            sink1 = Sink(actor_index = 0);
            //sink2 = Sink(actor_index = 1);
    structure
            source1.Out --> DUT.In { bufferSize = 1; };
            //source2.Out --> DUT.In2 { bufferSize = 1; };
            DUT.Out --> sink1.In { bufferSize = 1; } ;
            //DUT.Out2 --> sink2.In { bufferSize = 1; } ;
    end
end