// Rx: 147

namespace simple:
    actor ForeachComplex() int In ==> int Out:
        action In:[t] ==> Out:[a + b]
        var
            int a := 0,
            int b := 0
        do
            foreach uint(size=8) j in 0..2+2*2 do
                b := b + 1;
                a := a + j;
                println("a1: " + a + " b1: " + b);
                foreach uint j in 0..2+2*2 do
                    b := b + 1;
                    a := a + j;
                    println("    a2: " + a + " b2: " + b);
                end
            end
            println("a3: " + a + " b3: " + b);
        end
    end

    actor Source(int payload_size) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter
        do
            t :=  t+1;
            println("Tx: " + t);
            counter := counter + 1;
        end
    end

    actor Sink() int In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source = Source(payload_size = 3);
            pass  = ForeachComplex() {};
            sink = Sink();
    structure
            source.Out --> pass.In { bufferSize = 4; };
            pass.Out --> sink.In { bufferSize = 4; } ;
    end
end