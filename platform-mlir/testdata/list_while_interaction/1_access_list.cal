namespace simple:
    actor AccessList() int In ==> int Out:
        action In:[t1] repeat 4 ==> Out:[sum]
        var
        int sum := 0,
        int index := 0
        do
        while index < 4 do
            sum := sum + t1[index];
            index := index + 1;
        end
        end
    end

    actor Source(int payload_size) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter
        do
            t := (t + 1 ) * 10;
            println("Tx: " + t);
            counter := counter + 1;
        end
    end

    actor Sink() int In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source = Source(payload_size = 4);
            pass  = AccessList() {};
            sink = Sink();
    structure
            source.Out --> pass.In { bufferSize = 4; };
            pass.Out --> sink.In { bufferSize = 1; } ;
    end
end