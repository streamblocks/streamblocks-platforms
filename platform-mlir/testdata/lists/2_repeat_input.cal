// Expected Output
// Tx1: 101
// Tx2: 201
// Tx1: 102
// Tx2: 202
// Rx: 607
// Tx1: 103
// Tx2: 203

namespace simple:
    actor RepeatInput() int In1, int In2 ==> int Out:
        action In1:[t1] repeat 2, In2:[t2] repeat 2 ==> Out:[a]
        var
            int b := 1,
            int a
        do
            a := t1[0] + t1[1] + t2[0] + t2[1] + b;
        end
    end

    actor Source(int payload_size, int actor_index) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 100*actor_index
        do
            t :=  t+1;
            println("Tx" + actor_index + ": " + t);
            counter := counter + 1;
        end
    end

    actor Sink() int In ==>:
        action In:[t] ==>
        do
            println("Rx: " + t);
        end
    end

    network Top() ==> :
    entities
            source1 = Source(payload_size = 3, actor_index = 1);
            source2 = Source(payload_size = 3, actor_index = 2);
            pass  = RepeatInput() {};
            sink = Sink();
    structure
            source1.Out --> pass.In1 { bufferSize = 2; };
            source2.Out --> pass.In2 { bufferSize = 2; };
            pass.Out --> sink.In { bufferSize = 1; } ;
    end
end