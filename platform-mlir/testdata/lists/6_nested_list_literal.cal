// Expected Output:
// Tx0: 1
// Rx0: 20
// Rx0: 40
// Rx0: 60
// Rx0: 80
// Rx0: 100
// Rx0: 120


namespace simple:
    actor NestedLiterals() int In ==> int Out:
        action In:[t1] ==> Out:[out_list] repeat 6
        var
            List(type:List(type:uint, size=3), size=2) twoDList,//s := [[10,20,30], [40,50,60]],
            List(type:uint, size=6) out_list,
            uint inner_index := 0,
            uint outer_index := 0,
            uint out_list_index := 0
        do
            while outer_index < 2 do
                inner_index := 0;
                while inner_index < 3 do
                    twoDList[outer_index][inner_index] := 1 + inner_index + outer_index * 3;
                    inner_index := inner_index + 1;
                end
                outer_index := outer_index + 1;
            end

            inner_index := 0;
            outer_index := 0;
            while outer_index < 2 do
                inner_index := 0;
                while inner_index < 3 do
                    twoDList[outer_index][inner_index] := twoDList[outer_index][inner_index] * 20;
                    inner_index := inner_index + 1;
                end
                outer_index := outer_index + 1;
            end

            inner_index := 0;
            outer_index := 0;
            out_list_index := 0;
            while outer_index < 2 do
                inner_index := 0;
                while inner_index < 3 do
                    out_list[out_list_index] := twoDList[outer_index][inner_index];
                    out_list_index := out_list_index + 1;
                    inner_index := inner_index + 1;
                end
                outer_index := outer_index + 1;
            end
        end
    end

    actor Source(int payload_size, int actor_index) ==> int Out:
        int counter := 0;
        transmit: action ==> Out:[t]
        guard counter < payload_size
        var t := counter + 100*actor_index
        do
            t :=  t+1;
            println("Tx" + actor_index + ": " + t);
            counter := counter + 1;
        end
    end

    actor Sink(int actor_index) int In ==>:
        action In:[t] ==>
        do
            println("Rx" + actor_index + ": " + t);
        end
    end

    network Top() ==> :
    entities
            source = Source(payload_size = 1, actor_index = 0);
            DUT  = NestedLiterals() {};
            sink = Sink(actor_index = 0);
    structure
            source.Out --> DUT.In { bufferSize = 1; };
            DUT.Out --> sink.In { bufferSize = 6; } ;
    end
end